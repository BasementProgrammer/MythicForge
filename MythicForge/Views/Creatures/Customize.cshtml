@model MythicForge.ViewModels.CustomizeViewModel
@{
    ViewBag.Title = "Customize " + Model.Name;
}

<div class="row">
    <div class="@(Model.ImageGenerationEnabled ? "col-md-7" : "col-md-12")">
        <h2>@Model.Emoji Build your @Model.Name</h2>
        <p>@Model.Description</p>

        @using (Html.BeginForm("Customize", "Creatures", FormMethod.Post, new { id = "buildForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="CreatureTypeId" value="@Model.CreatureTypeId" />

            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="form-group">
                <label for="CreatureName">Name your creature (optional)</label>
                <input type="text" id="CreatureName" name="CreatureName" class="form-control" maxlength="80" placeholder="e.g. Sparkletooth" />
            </div>

            <h3>Color</h3>
            <div class="form-group">
                @foreach (var color in Model.Colors)
                {
                    <label class="radio-inline" style="margin-bottom: 8px;">
                        <input type="radio" name="ColorId" value="@color.Id"
                               class="js-price-input" data-price="@color.PriceModifier" data-label="@color.Name"
                               @(color.Id == Model.Colors.First().Id ? Html.Raw("checked=\"checked\"") : null) />
                        <span style="display:inline-block;width:14px;height:14px;border:1px solid #ccc;background:@color.HexValue;vertical-align:middle;"></span>
                        @color.Name
                        @if (color.PriceModifier != 0)
                        {
                            <text>(+@color.PriceModifier.ToString("C"))</text>
                        }
                    </label>
                }
            </div>

            foreach (var category in Model.Categories)
            {
                <h3>@category.Name @(category.IsRequired ? Html.Raw("<small class=\"text-danger\">*</small>") : null)</h3>
                <div class="form-group">
                    @foreach (var option in category.Options)
                    {
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="SelectedOptionIds" value="@option.Id"
                                       class="js-price-input js-option"
                                       data-price="@option.PriceModifier"
                                       data-category="@category.Id"
                                       data-label="@option.Name"
                                       data-single="@(category.SelectionType == MythicForge.Models.SelectionType.Single ? "true" : "false")" />
                                <strong>@option.Name</strong>
                                @if (!string.IsNullOrEmpty(option.Description))
                                {
                                    <span class="text-muted"> - @option.Description</span>
                                }
                                @if (option.PriceModifier != 0)
                                {
                                    <span class="text-success"> (+@option.PriceModifier.ToString("C"))</span>
                                }
                            </label>
                        </div>
                    }
                </div>
            }

            <div class="panel panel-primary" style="max-width:320px;">
                <div class="panel-heading">Price estimate</div>
                <div class="panel-body text-center">
                    <p class="text-muted" style="margin-bottom:4px;">Base @Model.BasePrice.ToString("C")</p>
                    <h2 id="priceDisplay" style="margin:0;">@Model.BasePrice.ToString("C")</h2>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Add to cart</button>
            @Html.ActionLink("Back to creatures", "Index", null, new { @class = "btn btn-default btn-lg" })
        }
    </div>

    @if (Model.ImageGenerationEnabled)
    {
        <div class="col-md-5">
            <div class="build-sidebar">
                <div class="panel">
                    <div class="panel-heading">Preview</div>
                    <div class="panel-body text-center">
                        <div class="preview-frame">
                            <img id="previewImage" class="preview-img" alt="AI-generated preview of your creature" style="display:none;" />
                            <div id="previewPlaceholder" class="preview-placeholder">
                                <div style="font-size:56px;line-height:1;">@Model.Emoji</div>
                                <p class="text-muted">Choose your options, then click <strong>Generate preview</strong> to see your creature.</p>
                            </div>
                            <div id="previewSpinner" class="preview-spinner" style="display:none;">
                                <div class="spinner-ring"></div>
                                <p class="text-muted">Conjuring your creature&hellip;</p>
                            </div>
                        </div>
                        <p id="previewError" class="text-danger" style="display:none;margin-top:10px;"></p>
                        <p id="previewPrompt" class="text-muted" style="display:none;font-size:.82rem;font-style:italic;margin-top:10px;"></p>
                        <button type="button" id="regenBtn" class="btn btn-primary btn-block" style="margin-top:12px;">
                            Generate preview
                        </button>
                        <p class="text-muted" style="font-size:.78rem;margin-top:8px;">Powered by Amazon Bedrock (Stability AI).</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Live price estimate (always on, no Bedrock dependency).
        (function () {
            var basePrice = @Model.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var priceDisplay = document.getElementById('priceDisplay');

            function recalc() {
                var total = basePrice;
                document.querySelectorAll('.js-price-input').forEach(function (el) {
                    if ((el.type === 'radio' || el.type === 'checkbox') && el.checked) {
                        total += parseFloat(el.getAttribute('data-price')) || 0;
                    }
                });
                if (priceDisplay) { priceDisplay.textContent = '$' + total.toFixed(2); }
            }

            // "single" categories behave like radio buttons; recalc on any change.
            document.querySelectorAll('.js-option').forEach(function (el) {
                el.addEventListener('change', function () {
                    if (this.checked && this.getAttribute('data-single') === 'true') {
                        var cat = this.getAttribute('data-category');
                        document.querySelectorAll('.js-option[data-category="' + cat + '"]').forEach(function (other) {
                            if (other !== el) { other.checked = false; }
                        });
                    }
                    recalc();
                });
            });

            document.querySelectorAll('input[name="ColorId"]').forEach(function (el) {
                el.addEventListener('change', recalc);
            });

            recalc();
        })();
    </script>

    @if (Model.ImageGenerationEnabled)
    {
        <text>
        <script>
            // Amazon Bedrock AI preview (generated only on explicit button click).
            (function () {
                var previewUrl = '@Url.Action("Preview", "Creatures")';
                var creatureTypeId = document.querySelector('input[name="CreatureTypeId"]').value;

                var img = document.getElementById('previewImage');
                var placeholder = document.getElementById('previewPlaceholder');
                var spinner = document.getElementById('previewSpinner');
                var errorEl = document.getElementById('previewError');
                var promptEl = document.getElementById('previewPrompt');
                var genBtn = document.getElementById('regenBtn');
                var inFlight = false;

                function generatePreview() {
                    if (inFlight) { return; }
                    inFlight = true;
                    genBtn.disabled = true;

                    errorEl.style.display = 'none';
                    placeholder.style.display = 'none';
                    if (img.getAttribute('src')) { img.style.opacity = '0.35'; }
                    spinner.style.display = 'block';

                    var params = new URLSearchParams();
                    params.append('creatureTypeId', creatureTypeId);

                    var color = document.querySelector('input[name="ColorId"]:checked');
                    params.append('colorId', color ? color.value : '0');

                    document.querySelectorAll('input[name="SelectedOptionIds"]:checked').forEach(function (el) {
                        params.append('selectedOptionIds', el.value);
                    });

                    // Include the anti-forgery token so the endpoint only accepts same-site requests.
                    var token = document.querySelector('input[name="__RequestVerificationToken"]');
                    if (token) { params.append('__RequestVerificationToken', token.value); }

                    fetch(previewUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: params.toString()
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        spinner.style.display = 'none';
                        if (data && data.ok) {
                            img.src = data.image;
                            img.style.opacity = '1';
                            img.style.display = 'block';
                            if (data.prompt) {
                                promptEl.textContent = '\u201C' + data.prompt + '\u201D';
                                promptEl.style.display = 'block';
                            }
                        } else {
                            img.style.opacity = '1';
                            errorEl.textContent = 'Could not generate preview: ' + ((data && data.error) || 'unknown error');
                            errorEl.style.display = 'block';
                            if (img.style.display === 'none') { placeholder.style.display = 'block'; }
                        }
                    })
                    .catch(function (e) {
                        spinner.style.display = 'none';
                        img.style.opacity = '1';
                        errorEl.textContent = 'Could not generate preview: ' + e.message;
                        errorEl.style.display = 'block';
                        if (img.style.display === 'none') { placeholder.style.display = 'block'; }
                    })
                    .then(function () { inFlight = false; genBtn.disabled = false; });
                }

                genBtn.addEventListener('click', generatePreview);
            })();
        </script>
        </text>
    }
}

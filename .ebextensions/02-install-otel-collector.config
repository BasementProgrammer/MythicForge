# Installs and runs the OpenTelemetry Collector (contrib distribution) as a Windows
# service on the Elastic Beanstalk instance. The app exports OTLP traces to this local
# collector (see OTEL_EXPORTER_OTLP_ENDPOINT set by the CDK stack); the collector then
# forwards them to AWS X-Ray, which surfaces them in the CloudWatch console under
# Application monitoring > X-Ray traces.
#
# This is the AWS deployment path: the collector exists only on Elastic Beanstalk (where
# the app runs with DeploymentEnvironment=AWS), so forwarding to CloudWatch/X-Ray happens
# only in the AWS environment. Local development uses its own OTLP backend instead (see
# the README) and does not touch AWS.
#
# The collector receives OTLP over HTTP on localhost:4318. The "awsxray" exporter needs
# xray:Put* permissions, which the CDK stack grants to the EC2 instance role, and picks up
# the AWS region automatically from the instance metadata.
files:
  "C:\\otelcol\\config.yaml":
    content: |
      receivers:
        otlp:
          protocols:
            http:
              endpoint: localhost:4318

      processors:
        batch: {}

      exporters:
        # Forwards traces to AWS X-Ray -> visible in the CloudWatch console under
        # Application Signals (APM) > Traces (older layouts: a top-level "X-Ray traces").
        # Region is auto-detected from the EC2 instance metadata; the instance role grants
        # the required xray:Put* permissions. If auto-detection fails (e.g. an IMDS error
        # shows in the collector log), set it explicitly, e.g.:  awsxray: { region: ap-southeast-2 }
        awsxray: {}
        # Defined for troubleshooting: add "debug" to the pipeline exporters below to
        # also write spans to the collector's own log.
        debug:
          verbosity: normal

      service:
        pipelines:
          traces:
            receivers: [otlp]
            processors: [batch]
            exporters: [awsxray]

commands:
  # Pin a specific collector release for reproducible deployments. Bump this to adopt a
  # newer collector; the download URL and archive name are derived from it.
  10-download-otel-collector:
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "$ErrorActionPreference='Stop'; $ver='0.111.0'; $exe='C:\otelcol\otelcol-contrib.exe'; if (-not (Test-Path $exe)) { New-Item -ItemType Directory -Force -Path C:\otelcol | Out-Null; $tar=\"C:\otelcol\otelcol.tar.gz\"; $url=\"https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$ver/otelcol-contrib_${ver}_windows_amd64.tar.gz\"; Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $tar; & tar.exe -xzf $tar -C C:\otelcol; Remove-Item $tar -Force }"
    waitAfterCompletion: 0
  20-install-otel-service:
    # Register the collector as an auto-start Windows service. The collector binary has
    # built-in Windows service support and reads its config from --config.
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "$ErrorActionPreference='Stop'; if (-not (Get-Service -Name 'otelcol' -ErrorAction SilentlyContinue)) { New-Service -Name 'otelcol' -DisplayName 'OpenTelemetry Collector' -BinaryPathName '\"C:\otelcol\otelcol-contrib.exe\" --config \"C:\otelcol\config.yaml\"' -StartupType Automatic }"
    waitAfterCompletion: 0
  30-restart-otel-service:
    # (Re)start so config/binary changes from a redeploy take effect.
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "$ErrorActionPreference='Stop'; Restart-Service -Name 'otelcol' -Force"
    waitAfterCompletion: 5
    ignoreErrors: true

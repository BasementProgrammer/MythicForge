# Installs SQL Server 2019 Express LocalDB on the Elastic Beanstalk Windows
# instance so the app's "(LocalDB)\MSSQLLocalDB" connection string resolves.
#
# LocalDB is a per-user, on-demand engine and is not really intended to run
# under IIS, so we also enable the app pool user profile to give the automatic
# instance the best chance of starting under the ApplicationPoolIdentity.
commands:
  10-fetch-localdb:
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "$ErrorActionPreference='Stop'; New-Item -ItemType Directory -Force -Path C:\localdb | Out-Null; if (-not (Get-ChildItem -Path C:\localdb -Recurse -Filter SqlLocalDB.msi -ErrorAction SilentlyContinue)) { Invoke-WebRequest -UseBasicParsing -Uri 'https://go.microsoft.com/fwlink/?linkid=866658' -OutFile 'C:\localdb\SQL2019-SSEI-Expr.exe'; Start-Process -FilePath 'C:\localdb\SQL2019-SSEI-Expr.exe' -ArgumentList '/ACTION=Download','/MEDIATYPE=LocalDB','/MEDIAPATH=C:\localdb','/QUIET' -Wait }"
    waitAfterCompletion: 0
  20-install-localdb:
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "$ErrorActionPreference='Stop'; if (-not (Test-Path 'C:\Program Files\Microsoft SQL Server\150\Tools\Binn\SqlLocalDB.exe')) { $msi=(Get-ChildItem -Path C:\localdb -Recurse -Filter SqlLocalDB.msi -ErrorAction SilentlyContinue | Select-Object -First 1).FullName; if (-not $msi) { throw 'SqlLocalDB.msi not found after download' }; Start-Process msiexec.exe -ArgumentList '/i',$msi,'/qn','IACCEPTSQLLOCALDBLICENSETERMS=YES' -Wait }"
    waitAfterCompletion: 90
  30-apppool-load-profile:
    command: "%windir%\\system32\\inetsrv\\appcmd.exe set apppool \"DefaultAppPool\" /processModel.loadUserProfile:true /processModel.setProfileEnvironment:true"
    waitAfterCompletion: 0
    ignoreErrors: true
  40-create-sqldata-dir:
    # Fixed, writable location for the app's LocalDB .mdf, outside the web root so
    # msdeploy never touches it and the IIS app pool identity can create/write the file.
    command: powershell.exe -ExecutionPolicy Bypass -NoProfile -Command "New-Item -ItemType Directory -Force -Path 'C:\sqldata' | Out-Null; & icacls 'C:\sqldata' /grant 'IIS_IUSRS:(OI)(CI)M'"
    waitAfterCompletion: 0
